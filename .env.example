# Public Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public/publishable Supabase key. Safe to expose to the browser when RLS is enforced.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application URL used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase key for later trusted administrative operations.
# Do not add NEXT_PUBLIC_ to this variable and do not use it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret used to authenticate requests to the OpenAI API.
OPENAI_API_KEY=

# Text model used only when the optional web-search feature is enabled.
OPENAI_MODEL=gpt-5.6

# Image model used to generate and edit images.
OPENAI_IMAGE_MODEL=gpt-image-2

# Output quality: low is fastest/cheapest; medium and high cost more; auto lets OpenAI choose.
OPENAI_IMAGE_QUALITY=low

# Output dimensions: 1024x1024 is the cost-conscious square development size.
OPENAI_IMAGE_SIZE=1024x1024

# Input preservation for image models before GPT Image 2. GPT Image 2 always uses high fidelity.
OPENAI_IMAGE_INPUT_FIDELITY=low
