# Public Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public/publishable Supabase key. Safe to expose to the browser when RLS is enforced.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application URL used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only key used for trusted credit mutations and admin jobs.
# Set either the legacy service-role key or the newer Supabase secret key.
# Never add NEXT_PUBLIC_ to either variable or use either one in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Initial generation credits provisioned lazily on a user's first credit-aware request.
# Must be an integer between 0 and 100000.
SIGNUP_CREDITS=25

# Server-only secret used to authenticate requests to the OpenAI API.
OPENAI_API_KEY=

# Text model used only when the optional web-search feature is enabled.
OPENAI_MODEL=gpt-5.6

# Output dimensions. Model and quality are selected from the server-controlled
# image preset catalog in lib/image-models.ts so clients cannot choose arbitrary
# provider models or pricing.
OPENAI_IMAGE_SIZE=1024x1024
